{
  "version": 2,
  "name": "4site-pro",
  "buildCommand": "./vercel-build.sh",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "NODE_ENV": "production",
    "CI": "true",
    "DISABLE_LOGGING": "true"
  },
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
