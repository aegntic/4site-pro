# ================================================================================================
# 4SITE.PRO ENHANCED VIRAL MECHANICS ENVIRONMENT CONFIGURATION
# Production-Grade Setup for $100B Platform Standards
# ================================================================================================

# ================================================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ================================================================================================

# Production Supabase Project URL
# Get from: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous Key (safe for client-side use)
# Get from: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (NEVER expose client-side - server use only)
# Get from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Database URL for migrations and admin operations
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ================================================================================================
# AI SERVICES (REQUIRED FOR SITE GENERATION)
# ================================================================================================

# Google Gemini API Key (Required for AI content generation)
# Get from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (alternative AI provider)
# Get from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your-openai-key-here

# ================================================================================================
# GITHUB INTEGRATION (RECOMMENDED)
# ================================================================================================

# GitHub Personal Access Token (for enhanced repository analysis)
# Create at: https://github.com/settings/tokens
# Permissions needed: repo (for private repos), public_repo (for public repos)
VITE_GITHUB_TOKEN=github_pat_your-token-here

# ================================================================================================
# ENHANCED VISUAL GENERATION (OPTIONAL)
# ================================================================================================

# FAL.ai API Key (for enhanced image generation)
# Get from: https://fal.ai/dashboard
VITE_FAL_API_KEY=your-fal-api-key-here

# ================================================================================================
# PAYMENT PROCESSING (FOR PRODUCTION)
# ================================================================================================

# Stripe Keys for subscription management
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ================================================================================================
# ANALYTICS AND MONITORING (RECOMMENDED)
# ================================================================================================

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog Analytics Key (for user behavior tracking)
# Get from: https://posthog.com/
VITE_POSTHOG_API_KEY=your-posthog-api-key
VITE_POSTHOG_API_HOST=https://app.posthog.com

# Sentry DSN for error monitoring
# Get from: https://sentry.io/
VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ================================================================================================
# EMAIL SERVICES (FOR NOTIFICATIONS)
# ================================================================================================

# SendGrid API Key for transactional emails
# Get from: https://sendgrid.com/
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Resend API Key (alternative email service)
# Get from: https://resend.com/
RESEND_API_KEY=re_your-resend-api-key

# ================================================================================================
# VIRAL MECHANICS CONFIGURATION
# ================================================================================================

# Viral score calculation intervals
VIRAL_SCORE_UPDATE_INTERVAL=3600000  # 1 hour in milliseconds
AUTO_FEATURING_CHECK_INTERVAL=300000  # 5 minutes in milliseconds

# Commission calculation settings
COMMISSION_NEW_RATE=0.20      # 20% for first 12 months
COMMISSION_ESTABLISHED_RATE=0.25  # 25% for months 13-48
COMMISSION_LEGACY_RATE=0.40   # 40% for 4+ years

# Free Pro milestone settings
FREE_PRO_REFERRAL_THRESHOLD=10    # Number of referrals needed
FREE_PRO_DURATION_MONTHS=12       # Duration of free Pro in months

# Auto-featuring thresholds
AUTO_FEATURING_SHARE_THRESHOLD=5  # Shares needed for auto-featuring
AUTO_FEATURING_VIRAL_THRESHOLD=100  # Viral score for high-priority featuring

# ================================================================================================
# FEATURE FLAGS
# ================================================================================================

# Enhanced viral mechanics features
ENABLE_VIRAL_SCORING=true
ENABLE_AUTO_FEATURING=true
ENABLE_COMMISSION_SYSTEM=true
ENABLE_PRO_SHOWCASE=true
ENABLE_SHARE_TRACKING=true

# Advanced features
ENABLE_AI_CONTENT_GENERATION=true
ENABLE_DEEP_ANALYSIS=true
ENABLE_CUSTOM_DOMAINS=true

# ================================================================================================
# APPLICATION SETTINGS
# ================================================================================================

# Environment mode
NODE_ENV=production

# Application URLs
VITE_APP_URL=https://4site.pro
VITE_API_URL=https://api.4site.pro

# API Configuration
VITE_API_TIMEOUT=30000
VITE_ENABLE_ANALYTICS=true

# Performance settings
VIRAL_SCORE_CACHE_TTL=3600    # 1 hour cache for viral scores
COMMISSION_BATCH_SIZE=100     # Process commissions in batches
SHARE_TRACKING_BATCH_SIZE=50  # Batch share tracking updates

# ================================================================================================
# SECURITY CONFIGURATION
# ================================================================================================

# JWT Secret for custom token signing (generate secure random string)
JWT_SECRET=your-super-secure-jwt-secret-here

# API Rate Limiting (requests per minute)
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_VIRAL_ACTIONS=50

# CORS Origins (comma-separated for production)
CORS_ORIGINS=https://4site.pro,https://www.4site.pro,https://app.4site.pro

# ================================================================================================
# DEPLOYMENT CONFIGURATION
# ================================================================================================

# Vercel Deployment (Optional - for one-click deployment)
VITE_VERCEL_TOKEN=your_vercel_token

# Health check settings
HEALTH_CHECK_INTERVAL=30000  # 30 seconds
HEALTH_CHECK_TIMEOUT=5000    # 5 seconds

# ================================================================================================
# QUICK SETUP CHECKLIST
# ================================================================================================

# Required for Basic Functionality:
# [ ] VITE_SUPABASE_URL
# [ ] VITE_SUPABASE_ANON_KEY  
# [ ] VITE_GEMINI_API_KEY

# Recommended for Production:
# [ ] DATABASE_URL
# [ ] SUPABASE_SERVICE_ROLE_KEY
# [ ] VITE_STRIPE_PUBLISHABLE_KEY
# [ ] STRIPE_SECRET_KEY

# Enhanced Viral Mechanics:
# [ ] ENABLE_VIRAL_SCORING=true
# [ ] ENABLE_AUTO_FEATURING=true
# [ ] ENABLE_COMMISSION_SYSTEM=true
# [ ] ENABLE_PRO_SHOWCASE=true
# [ ] ENABLE_SHARE_TRACKING=true

# ================================================================================================
# NOTES FOR DEVELOPERS
# ================================================================================================

# 1. Copy this file to .env.local for development
# 2. Never commit actual API keys to version control
# 3. Use different keys for development, staging, and production
# 4. Rotate keys regularly (quarterly recommended)
# 5. Test all viral mechanics in staging before production
# 6. Monitor viral score calculations for performance
# 7. Set up alerts for commission calculation errors